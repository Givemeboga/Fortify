# Copy to .env to override without editing docker-compose.yml.
# The browser calls this URL directly, so for cloud deploys it must be the
# backend's PUBLIC address (e.g. https://fortify-api.example.com).
VITE_API_URL=http://localhost:8500

# --- Backend hardening (read by fortify-go; all optional) ---
# Require `Authorization: Bearer <token>` on every API route (health check
# excluded). The dashboard sends the token you paste in Counsel → API TOKEN.
# FORTIFY_API_TOKEN=
# Browser origins allowed to call the API (comma-separated; "*" = any).
# Must include your public dashboard URL when deploying to the cloud.
# ALLOWED_ORIGINS=http://localhost:5173
# Scan targets resolving to private/loopback/link-local IPs are rejected
# (SSRF guard). Set to 1 only for labs that intentionally scan local hosts.
# FORTIFY_ALLOW_PRIVATE_IPS=
# Max concurrent scans; extra scans queue instead of exhausting the host.
# FORTIFY_MAX_SCANS=3
