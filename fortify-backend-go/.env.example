LLM_PROVIDER=ollama

# Local (default) — data never leaves the machine.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL defaults to http://localhost:11434/api/generate locally;
# docker-compose overrides it to http://host.docker.internal:11434/api/generate.

# Cloud fallbacks (bring your own key — or paste it in the dashboard Counsel,
# which takes precedence per request).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Custom OpenAI-compatible endpoint (Groq, Together, OpenRouter, Mistral,
# LM Studio, …) used with "provider": "custom".
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=
# CUSTOM_LLM_API_KEY=

# PORT=8500
# FORTIFY_DB_PATH=/app/data/fortify.db
